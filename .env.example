# Names only: never commit values. Set DATABASE_URL in the host's environment (Vercel project settings).
# Managed Postgres, pooled connection string (e.g. Neon). When unset, local development and tests use PGlite.
DATABASE_URL=
# Optional: connections per server instance (default 3).
DATABASE_POOL_MAX=
# Stripe TEST mode only (sk_test_ / pk_test_). Set in Vercel / .env.local, never commit values.
# When STRIPE_SECRET_KEY is unset the demo payment provider is used.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
